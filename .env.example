# =============================================================================
# 환경 변수 템플릿 — 이 파일을 .env로 복사한 뒤 빈 값을 채우세요.
#   macOS/Linux : cp .env.example .env
#   Windows     : Copy-Item .env.example .env
# 자세한 방법은 README의 "5. 환경 설정 (.env)"를 참고하세요.
# .env에는 토큰이 들어가므로 절대 커밋하지 마세요 (.gitignore에 포함됨).
# =============================================================================

# ---- [1] Gemini 접근 (A 또는 B 중 하나) ---------------------------------------
# A. Vertex AI (권장): GCP 프로젝트 ID를 입력
#    확인: gcloud config get-value project
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# B. Gemini API 키: 위 A의 GOOGLE_GENAI_USE_VERTEXAI를 false로 바꾸고 키 입력
#    발급: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ---- [2] HR/IT 백엔드 (MCP) -------------------------------------------------
# 포털 오른쪽 위 "🔑 MCP 토큰 발급"에서 받은 토큰 (mcp_ 로 시작, 7일 유효)
MCP_BASE_URL=https://korean-mock-saas-dri5akvbzq-du.a.run.app
MCP_TOKEN=

# 비워 두면 토큰 주인의 사번을 자동으로 찾습니다 (권장)
EMPLOYEE_ID=

# ---- [3] 규정 검색 (RAG) 벡터 스토어 ------------------------------------------
# false : 로컬 메모리 검색 (GCP 불필요, 바로 실행 가능)
# true  : Vertex AI Search 데이터 스토어 사용
#         먼저 `uv run python scripts/setup_vector_store.py` 실행 (README 7단계)
USE_VERTEX_SEARCH=false
DATA_STORE_ID=hr-policies-local
DATA_STORE_LOCATION=global

# ---- [4] 기타 (보통 그대로 두세요) ---------------------------------------------
SUPERVISOR_MODEL=gemini-2.5-flash
WORKER_MODEL=gemini-2.5-flash
# true로 바꾸면 모든 도구 호출이 차단됩니다 (CISO 킬 스위치)
CISO_KILL_SWITCH_ACTIVE=false
# TIMEZONE=Asia/Seoul
# WORKWEEK_MCP_PATH=/work-week/mcp
# ITSM_MCP_PATH=/service-immediately/mcp
